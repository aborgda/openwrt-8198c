# KT510 board profile
# SoC: RTL8198
# WLAN: RTL8192ER + RTL8812AR
# Flash: 16 MiB
CONFIG_BOARD_rtl8198=y
# Board configuration
CONFIG_MODEL_RTL8198_SPI_SQUASHFS=y
# Kernel
CONFIG_LINUX_2.6.30=y
# Realtek base features
CONFIG_RTL_819X=y
CONFIG_RTL_8198=y
CONFIG_RTL_8198_GW=y
CONFIG_RTL819X_SPI_FLASH=y
CONFIG_RTL_FLASH_MAPPING_ENABLE=y
CONFIG_RTL_FLASH_SIZE=0x1000000
CONFIG_ROOTFS_SQUASH=y
# Wireless requested for KT510
CONFIG_RTL_92E_SUPPORT=y
CONFIG_RTL_8812_SUPPORT=y
