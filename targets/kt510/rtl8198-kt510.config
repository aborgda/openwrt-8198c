# KT510 board profile
# SoC: RTL8198
# WLAN requested: RTL8192ER + RTL8812AR
# Flash dump size: 16 MiB

CONFIG_BOARD_rtl8198=y
CONFIG_MODEL_RTL8198_SPI_SQUASHFS=y
CONFIG_LINUX_2.6.30=y

CONFIG_RTL_819X=y
CONFIG_RTL_8198=y
CONFIG_RTL_8198_GW=y

CONFIG_RTL819X_SPI_FLASH=y
CONFIG_RTL_FLASH_MAPPING_ENABLE=y
CONFIG_RTL_FLASH_SIZE=0x1000000
CONFIG_ROOTFS_SQUASH=y

# Wireless driver symbols are intentionally not hard-coded here.
# Enable the exact RTL8192ER/RTL8812AR symbols from the SDK revision in use.
