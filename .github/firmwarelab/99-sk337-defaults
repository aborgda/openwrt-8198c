#!/bin/sh
# First-boot defaults for SK337. Preserve existing wireless security/key settings.
[ -n "$IPKG_INSTROOT" ] && exit 0

uci -q set system.@system[0].hostname='sk337'

uci -q set network.lan.proto='static'
uci -q set network.lan.ipaddr='192.168.1.1'
uci -q set network.lan.netmask='255.255.255.0'

# Rename existing AP interfaces only; keep encryption and key settings unchanged.
for section in $(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
    mode="$(uci -q get wireless."$section".mode 2>/dev/null || true)"
    [ "$mode" = "ap" ] && uci -q set wireless."$section".ssid='sk337'
done

uci -q commit system
uci -q commit network
uci -q commit wireless
exit 0
