#!/bin/sh /etc/rc.common

START=99

start() {
	[ -x /sbin/wifi ] || return 0
	/sbin/wifi config >/dev/null 2>&1 || true

	uci -q set wireless.radio0.disabled='0'
	uci -q set wireless.radio1.disabled='0'

	uci -q set wireless.default_radio0.disabled='0'
	uci -q set wireless.default_radio0.ssid='GN866-AC-2G'
	uci -q set wireless.default_radio0.encryption='none'
	uci -q set wireless.default_radio0.network='lan'

	uci -q set wireless.default_radio1.disabled='0'
	uci -q set wireless.default_radio1.ssid='GN866-AC-5G'
	uci -q set wireless.default_radio1.encryption='none'
	uci -q set wireless.default_radio1.network='lan'

	uci commit wireless
	/sbin/wifi up >/dev/null 2>&1 || true
}
